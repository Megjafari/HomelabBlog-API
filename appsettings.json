{
  "Jwt": {
    "Issuer": "HomelabBlogApi",
    "Audience": "HomelabBlogAdmin",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Site": {
    "BaseUrl": "http://localhost:5173",
    "Title": "Homelab Journal",
    "Description": "Notes on running Kubernetes, networking, and self-hosting at home."
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Minio": {
    "BucketName": "homelab-blog",
    "UseSsl": false
  }
}
