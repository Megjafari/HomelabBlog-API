# Required secrets/config. ASP.NET maps "__" to ":" in environment variables.
ConnectionStrings__BlogDb=Host=postgres-vm-ip;Database=blog;Username=blog;Password=change-me
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-characters
AdminUser__Username=admin
# BCrypt hash of the admin password (see docs/deploy.md for how to generate one)
AdminUser__PasswordHash=

# Production frontend origin (CORS) and the URL used in RSS links
Cors__AllowedOrigins__0=https://blog.meghdadjafari.dev
Site__BaseUrl=https://blog.meghdadjafari.dev

# Image storage. Local (default) stores files on disk and serves them from /uploads.
Storage__Provider=Local
Storage__LocalPath=/data/uploads
Storage__PublicBaseUrl=https://blog-api.meghdadjafari.dev/uploads

# Optional: use MinIO instead (Storage__Provider=Minio)
# Minio__Endpoint=minio:9000
# Minio__AccessKey=
# Minio__SecretKey=
# Minio__UseSsl=false
# Minio__PublicBaseUrl=https://img.example.com/homelab-blog
