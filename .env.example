# Required secrets/config. ASP.NET maps "__" to ":" in environment variables.
ConnectionStrings__BlogDb=Host=postgres;Database=blog;Username=blog;Password=change-me
Jwt__SigningKey=change-me-to-a-random-string-of-at-least-32-characters
AdminUser__Username=admin
# BCrypt hash of the admin password (escape $ as $$ in docker compose files)
AdminUser__PasswordHash=
Minio__Endpoint=minio:9000
Minio__AccessKey=
Minio__SecretKey=
Minio__UseSsl=false
# Public URL images are served from (defaults to http://<endpoint>/<bucket>)
Minio__PublicBaseUrl=https://img.example.com/homelab-blog
# Production frontend origin(s)
Cors__AllowedOrigins__0=https://blog.example.com
# Used for RSS links (public URL of the frontend)
Site__BaseUrl=https://blog.example.com
